Header set X-Content-Type-Options: "nosniff"
Header set X-Frame-Options: "sameorigin"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set x-xss-protection "1; mode=block"


AddDefaultCharset UTF-8

Header set Content-Security-Policy "font-src 'self' https://use.fontawesome.com/ https://fonts.googleapis.com https://cdnjs.cloudflare.com; style-src 'self' https://use.fontawesome.com/ https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com 'unsafe-inline'; base-uri 'self';"


